{
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://pulpiai.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
